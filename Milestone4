    "Then I need to normalize the movie titles, removing any random characters, spaces, and convert to lower case to try to help in finding the name of the movie in the api. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "54254d48-5f96-49ff-84b0-24d721b8019d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# function to normalize the movie titles\n",
    "def normalize_title(title):\n",
    "    # convert to lowercase\n",
    "    title = title.lower()\n",
    "    # remove special characters (keep only letters and numbers)\n",
    "    title = re.sub(r'[^a-z0-9\\s]', '', title)\n",
    "    # remove extra internal spaces\n",
    "    title = re.sub(r'\\s+', ' ', title).strip()\n",
    "    return title\n",
    "\n",
    "# apply normalization\n",
    "# create a Simplified_Title column for the stripped version and use the pretty Movie_Title column for displays\n",
    "movies['Simplified_Title'] = movies['title'].apply(normalize_title)"
   ]
